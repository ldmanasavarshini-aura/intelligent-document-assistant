PORT=3001
# In production, set this to the exact deployed Vercel origin.
CORS_ORIGIN=http://localhost:5173
# Public frontend setting. It is embedded in the browser bundle; never put secrets here.
VITE_API_URL=http://localhost:3001
# Backend-only Postgres connection string. Keep it out of all VITE_ variables.
DATABASE_URL=
# Optional. Without a key, document questions are answered locally in the browser.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional: use a compatible API endpoint instead.
# OPENAI_BASE_URL=https://api.openai.com/v1/chat/completions
